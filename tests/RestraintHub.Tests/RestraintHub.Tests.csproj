<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs without the game: compiles only the Unity-free logic of the mod (+ the pure part of SfmKit). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RestraintHub.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\mods\RestraintHub\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\SfmKit\Pure\**\*.cs" Link="SfmKit.Pure\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
